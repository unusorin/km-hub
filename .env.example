# Per-machine parameters for the Makefile. Copy to .env (gitignored) and edit.
# Command-line overrides still win: `make run TRANSPORT=l2cap`.
#
# Unrelated to /home/admin/km-hub.env on the Pi, which holds secrets for [[hook]]
# commands (HA_URL, HA_TOKEN) and is read by km-hub.service.

# ssh target for the Pi (key-based login). Required.
PI=user@hostname
# Directory on the Pi (relative to $HOME) that holds the binary, config and setup.sh.
REMOTE_DIR=km-hub
# Cross-compile target for the Pi.
TARGET=aarch64-unknown-linux-gnu
# Transport for `make run`: le | l2cap | log
TRANSPORT=le
# Log filter for `make run`.
RUST_LOG=km_hub=debug
