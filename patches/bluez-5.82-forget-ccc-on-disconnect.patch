@@ -350,6 +360,12 @@
 			device_store_svc_chng_ccc(device, state->bdaddr_type,
 								ccc->value);
 
+		/* km-hub: a reconnecting bonded client re-enables its CCCs;
+		 * with the old values still here that write is a no-op and an
+		 * AcquireNotify application never hears from the client again.
+		 */
+		queue_foreach(state->ccc_states, forget_ccc_value,
+							UINT_TO_PTR(handle));
 		return;
