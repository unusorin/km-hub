+/* km-hub: see the patch description */
+static void forget_ccc_value(void *data, void *user_data)
+{
+	struct ccc_state *ccc = data;
+	uint16_t keep = PTR_TO_UINT(user_data);
+
+	if (ccc->handle != keep)
+		ccc->value = 0;
+}
